# Backend service env template (task 17). Copy to backend/.env.
DATABASE_URL=postgresql+asyncpg://omniusgrid:change_me@localhost:5432/omniusgrid
REDPANDA_URL=localhost:9092
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change_me_generate_a_long_random_value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# Security middleware (enable in production)
RATE_LIMIT_ENABLED=false
SECURITY_HEADERS_ENABLED=false

# Edge enrollment / internal CA
EDGE_BOOTSTRAP_TOKEN=
EDGE_CA_CERT_PATH=/certs/edge-ca.crt
EDGE_CA_KEY_PATH=/certs/edge-ca.key
EDGE_CERT_TTL_DAYS=30

# Distributed tracing (OpenTelemetry) — off unless enabled
OTEL_ENABLED=false
OTEL_SERVICE_NAME=omniusgrid-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
