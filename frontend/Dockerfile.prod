# Production image (FS-39): build the SPA, serve via nginx.
# The dev Dockerfile (./Dockerfile) keeps the hot-reload workflow; compose's
# prod profile and k8s use this one.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Build-time API base is left unset on purpose: production bundles default to
# SAME-ORIGIN (client.ts / websocket.ts), which nginx proxies to the backend.
# vite build only: type checking is CI's job (blocking tsc + `npm run build`
# gates since FS-53/54); the image build just emits the bundle.
RUN npx vite build

FROM nginx:1.27-alpine
# envsubst template: BACKEND_ORIGIN is resolved at container start.
ENV BACKEND_ORIGIN=http://backend:8000
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# Non-root (FS-77): run as the image's unprivileged `nginx` user (uid 101).
# nginx listens on 8080 (see nginx.conf) so no privileged port bind is needed.
# Redirect the pid to a writable path and hand the runtime dirs to the user so
# the master process can start without root.
RUN sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /usr/share/nginx/html \
    && touch /tmp/nginx.pid \
    && chown nginx:nginx /tmp/nginx.pid
USER nginx

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/ || exit 1
