# Frontend (Vite) env template. Copy to frontend/.env.local and adjust.

# API + WebSocket base for the web app. Mobile uses EXPO_PUBLIC_API_URL.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Mock data: OFF by default so web and the supervisor mobile app read the same
# live FastAPI routes. Set to true only for an offline browser demo (no backend).
# VITE_USE_MOCK=true

# Dev login bypass (username "dev" + any password). Only honored in a dev build
# (never in a production bundle). Leave unset in normal use.
# VITE_DEV_MODE=true
