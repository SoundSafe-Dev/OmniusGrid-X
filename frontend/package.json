{
  "name": "opsgrid-dashboard",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9999",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "video:studio": "remotion studio video/src/index.ts",
    "video:still": "remotion still video/src/index.ts",
    "video:render": "remotion render video/src/index.ts DemoVideo out/omniusgrid-demo-4k.mp4 --codec=h264 --crf=17 --concurrency=2",
    "video:render:hevc": "remotion render video/src/index.ts DemoVideo out/omniusgrid-demo-4k-hevc.mp4 --codec=h265 --crf=21 --concurrency=2",
    "video:studio:mobile": "remotion studio video/src/mobile/index.ts",
    "video:render:mobile": "remotion render video/src/mobile/index.ts DemoVideoMobile out/omniusgrid-demo-mobile-9x16.mp4 --codec=h264 --crf=17 --concurrency=2",
    "e2e:prod": "playwright test --config playwright.prod.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "plotly.js-dist-min": "^2.35.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "4.0.487",
    "@remotion/tailwind": "4.0.487",
    "@remotion/transitions": "4.0.487",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-plotly.js": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "i18next": "^23.16.8",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "react-i18next": "^15.7.4",
    "remotion": "4.0.487",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
