# OmniusGrid environment template (task 17). Copy to .env and adjust.
# `.env` is gitignored — never commit real secrets.

# --- Core services (docker-compose) ---
POSTGRES_USER=omniusgrid
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=omniusgrid
DATABASE_URL=postgresql+asyncpg://omniusgrid:change_me_in_prod@timescaledb:5432/omniusgrid
REDPANDA_URL=redpanda:29092
REDIS_URL=redis://redis:6379/0

# --- Auth / security ---
JWT_SECRET_KEY=change_me_generate_a_long_random_value
ENVIRONMENT=development            # development | staging | production
# Dev conveniences — MUST be false in production (startup fails fast otherwise).
ALLOW_DEV_TOKEN=true               # accept "dev-token" as an admin bypass
ALLOW_OPEN_REGISTRATION=true       # unauthenticated POST /api/v1/auth/register
# CORS: comma-separated origin allowlist ("*" rejected in production).
CORS_ALLOW_ORIGINS=*

# --- Observability / admin ---
GRAFANA_ADMIN_PASSWORD=change_me_in_prod

# --- Edge enrollment (see backend/.env.example) ---
EDGE_BOOTSTRAP_TOKEN=

# --- Distributed tracing (off by default) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
