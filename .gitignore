# Test + coverage artifacts. These are produced by running the suites locally and
# were showing up as untracked noise on every `git status`, which is how a real
# untracked file gets missed.
.coverage
.coverage.*
htmlcov/
coverage.xml
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Vendor ERP API specifications fetched by tools/erp-mocks/fetch-spec.sh.
# Not committed: they are vendor material, they are large (SAP's is 168KB for ONE
# service), and a per-tenant spec embeds that tenant's custom fields and records.
# Re-fetch them instead -- fetch-spec.sh encodes each vendor's exact endpoint,
# Accept header and compression requirements.
tools/erp-mocks/specs/*
!tools/erp-mocks/specs/.gitkeep

# ERP credential files. `.env.erp` holds live vendor credentials -- a SAP API key
# issued to a person, Entra ID client secrets, Intuit refresh tokens. The generic
# `.env` rule above does NOT match `.env.erp`, which is how a real credential could
# have been committed by someone following the setup docs.
# Templates (*.example) stay tracked.
.env.erp
.env.erp.*
backend/.env.erp
backend/.env.erp.*
!*.example
