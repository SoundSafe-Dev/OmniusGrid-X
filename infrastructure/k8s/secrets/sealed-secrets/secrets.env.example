# Copy to secrets.env (gitignored) and fill in REAL values, then run ./seal.sh.
# This file is only a template — it holds no real secrets.

# database-credentials
DATABASE_URL="postgresql+asyncpg://omniusgrid:CHANGEME@omniusgrid-db-rw:5432/omniusgrid"
DATABASE_USERNAME="omniusgrid"
DATABASE_PASSWORD="CHANGEME"
DATABASE_NAME="omniusgrid"

# jwt-secret / signed-url-secret (use long random values, e.g. openssl rand -hex 32)
JWT_SECRET="CHANGEME"
SIGNED_URL_SECRET="CHANGEME"

# s3-credentials (SeaweedFS / object store)
S3_ACCESS_KEY="CHANGEME"
S3_SECRET_KEY="CHANGEME"

# alertmanager-secrets
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/CHANGE/ME"
PAGERDUTY_SERVICE_KEY="CHANGEME"

# backup-credentials (db-backup CronJob)
BACKUP_AWS_ACCESS_KEY_ID="CHANGEME"
BACKUP_AWS_SECRET_ACCESS_KEY="CHANGEME"
BACKUP_REGION="us-east-1"
BACKUP_BUCKET="opsgrid-backups"

# cnpg-app-credentials (must match DATABASE_USERNAME/PASSWORD)
CNPG_APP_USERNAME="omniusgrid"
CNPG_APP_PASSWORD="CHANGEME"

# cnpg-backup-credentials (CloudNativePG WAL archiving to S3)
CNPG_BACKUP_ACCESS_KEY_ID="CHANGEME"
CNPG_BACKUP_ACCESS_SECRET_KEY="CHANGEME"

# app-secrets (FS-514) — three product credentials that had no provisioning path at all
EDGE_BOOTSTRAP_TOKEN="CHANGEME"          # fleet enrollment; no device can enroll without it
ERP_ENCRYPTION_KEY="CHANGEME"            # at-rest key for stored vendor credentials
GEOTAB_WEBHOOK_SECRET="CHANGEME"         # HMAC for inbound GeoTab deliveries

# smtp-credentials (FS-514) — scheduled exports and alert email
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="CHANGEME"
SMTP_PASSWORD="CHANGEME"
SMTP_FROM_ADDRESS="omniusgrid@example.com"

# grafana-admin (FS-514)
GRAFANA_ADMIN_PASSWORD="CHANGEME"
